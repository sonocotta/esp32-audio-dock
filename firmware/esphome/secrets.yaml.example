# ESPHome secrets.
#
# The key names below are the ones ESPHome itself uses (the wizard and the
# Home Assistant add-on generate `wifi_ssid` / `wifi_password`), so these
# configs can be dropped into an existing ESPHome setup and compiled as-is.
#
# Copy this file and fill in your own values:
#   cp secrets.yaml.example secrets.yaml

# Your Wi-Fi SSID and password
wifi_ssid: "your_wifi_ssid"
wifi_password: "*********"

# OPTIONAL. Over-the-air update password.
#
# Unlike wifi_ssid / wifi_password, this key is not required: the board configs
# default `ota_password` to an empty string, which means the device skips OTA
# authentication, so they compile without this entry. Setting it here does NOT
# pick it up by itself - ESPHome has no way to test whether a secret exists, so
# the config has to ask for it. To use a password, put this in your own config:
#
#   substitutions:
#     ota_password: !secret ota_password
#
# If a device is ALREADY running firmware built with a password, you must do
# that, or OTA will be refused until you reflash over USB.
ota_password: "*********"

# Optional: key for encrypted OTA, see "Encrypted OTA" in README.md
# (generate with `openssl rand -base64 32`)
# ota_encryption_key: "*********"

# Password for the fallback access point (legacy boards only)
ap_password: "*********"

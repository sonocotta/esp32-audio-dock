# ESPHome secrets.
#
# The key names below are the ones ESPHome itself uses (the wizard and the
# Home Assistant add-on generate `wifi_ssid` / `wifi_password`), so these
# configs can be dropped into an existing ESPHome setup and compiled as-is.
#
# Copy this file and fill in your own values:
#   cp secrets.yaml.example secrets.yaml

# Your Wi-Fi SSID and password
wifi_ssid: "your_wifi_ssid"
wifi_password: "*********"

# Password used for over-the-air (OTA) updates
ota_password: "*********"

# Password for the fallback access point (legacy boards only)
ap_password: "*********"

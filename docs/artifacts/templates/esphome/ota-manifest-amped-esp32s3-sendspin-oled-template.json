{
    "name": "amped-esp32s3-sendspin-oled",
    "version": "$version",
    "builds": [
        {
            "chipFamily": "ESP32-S3",
            "ota": {
                "md5": "$md5",
                "path": "https://sonocotta.github.io/esp32-audio-dock/artifacts/binaries/esphome/amped-esp32s3-sendspin-oled/firmware.ota.bin",
                "release_url": "https://github.com/sonocotta/esp32-audio-dock/commit/$commitid",
                "summary": "Amped-ESP32-S3 Sendspin firmware (OLED screen) $version"
            }
        }
    ],
    "manifest_name": "ota-manifest-amped-esp32s3-sendspin-oled-latest.json"
}
